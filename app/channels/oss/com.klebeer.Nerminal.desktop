[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Nerminal
GenericName=TerminalEmulator

Exec=nerminal %U
StartupWMClass=com.klebeer.Nerminal

Keywords=shell;prompt;command;commandline;cmd;

Icon=com.klebeer.Nerminal

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for nerminal:// URLs.
MimeType=x-scheme-handler/nerminal;
