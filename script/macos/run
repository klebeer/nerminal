#!/bin/bash
#
# macOS-specific implementation of `./script/run`. Runs a local version of
# Warp as a real 'app' instead of a bare executable, so macOS can treat it
# like a real signed app (custom URL schemes, user notifications, etc.).
#
# This script is invoked by `./script/run`, which handles cross-platform
# setup (install_channel_config, binary name detection, feature-to-env-var
# mapping). The following env vars are expected to be set by the caller:
#   NERMINAL_BIN_NAME  — "warp" (internal local build) or "nerminal"
#   NERMINAL_CHANNEL   — "local" or "oss"
#   FEATURES       — comma-separated cargo features (already normalized)
# Must be called from the root directory of the warp repo.

set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
cd "${REPO_ROOT}"

: "${NERMINAL_BIN_NAME:?NERMINAL_BIN_NAME must be set (invoke via ./script/run)}"
: "${NERMINAL_CHANNEL:?NERMINAL_CHANNEL must be set (invoke via ./script/run)}"
: "${FEATURES:?FEATURES must be set (invoke via ./script/run)}"

# Resolve Cargo's actual target directory rather than assuming ./target. This
# honors a shared CARGO_TARGET_DIR / build.target-dir (e.g. set in
# ~/.cargo/config.toml), which is where `cargo bundle` writes the .app bundle.
TARGET_DIR="$(cargo metadata --no-deps --format-version 1 | jq -r .target_directory)"
if [ -z "$TARGET_DIR" ] || [ "$TARGET_DIR" = "null" ]; then
    TARGET_DIR="${REPO_ROOT}/target"
fi

if [ "$NERMINAL_CHANNEL" = "local" ]; then
    NERMINAL_APP_PATH="${TARGET_DIR}/debug/bundle/osx/WarpLocal.app"
    NERMINAL_SCHEME_NAME="warplocal"
else
    NERMINAL_APP_PATH="${TARGET_DIR}/debug/bundle/osx/Nerminal.app"
    NERMINAL_SCHEME_NAME="nerminal"
fi
DONT_OPEN=false
# Launches the binary with "open", meaning the Warp process is
# launched by the MacOS application launcher instead of a shell session.
# Note that since Warp isn't launched as a child process, using ctrl+c
# won't kill the app (but will kill the tail process displaying output).
# tl;dr better simulates running Warp Dev/Stable
OPEN_WITH_LAUNCHD=false

# Arguments to pass directly Warp (specified after --)
# This is not supported when opening with launchd, as passing CLI arguments to
# an application doesn't make sense.
NERMINAL_ARGS=()

# Export this variable so it can be referenced by app/build.rs later when
# running `cargo bundle`.
export FRAMEWORK_OVERRIDE="dev"

PARAMS=""
while (( "$#" )); do
  case "$1" in
    --)
      shift
      NERMINAL_ARGS=("$@")
      break
      ;;
    --dont-open)
      DONT_OPEN=true
      shift
      ;;
    --release)
      echo "Detected release build, pointing at release bundle under ${TARGET_DIR}/release/bundle"
      if [ "$NERMINAL_CHANNEL" = "local" ]; then
          NERMINAL_APP_PATH="${TARGET_DIR}/release/bundle/osx/WarpLocal.app"
      else
          NERMINAL_APP_PATH="${TARGET_DIR}/release/bundle/osx/Nerminal.app"
      fi
      PARAMS="$PARAMS $1"
      shift
      ;;
    --profile)
      PROFILE="$2"
      shift 2
      if [ "$NERMINAL_CHANNEL" = "local" ]; then
          NERMINAL_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/WarpLocal.app"
      else
          NERMINAL_APP_PATH="${TARGET_DIR}/${PROFILE}/bundle/osx/Nerminal.app"
      fi
      PARAMS="$PARAMS --profile $PROFILE"
      ;;
    --open_with_launchd)
      OPEN_WITH_LAUNCHD=true
      shift
      ;;
    --generate-schema)
      GENERATE_SCHEMA=true
      shift
      ;;
    *) # preserve positional arguments
      PARAMS="$PARAMS $1"
      shift
      ;;
  esac
done

rm -rf "$NERMINAL_APP_PATH"

pushd app > /dev/null
echo "Bundling app (bin: $NERMINAL_BIN_NAME)..."
cargo bundle --bin "$NERMINAL_BIN_NAME" --features "$FEATURES" $PARAMS
echo "Successfully bundled..."
popd > /dev/null

if [[ ",$FEATURES," =~ ",cocoa_sentry," ]]; then
  echo "Copying Sentry framework into app bundle..."
  SENTRY_FRAMEWORK="app/frameworks/dev/Sentry-Dynamic-WithARM64e.xcframework/macos-arm64_arm64e_x86_64/Sentry.framework"
  mkdir -p "$NERMINAL_APP_PATH/Contents/Frameworks"
  cp -a "$SENTRY_FRAMEWORK" "$NERMINAL_APP_PATH/Contents/Frameworks/"
fi
"${REPO_ROOT}/script/macos/add_framework_rpath" "$NERMINAL_APP_PATH/Contents/MacOS/$NERMINAL_BIN_NAME"

export NERMINAL_SCHEME_NAME
export NERMINAL_PLIST_PATH="$NERMINAL_APP_PATH/Contents/Info.plist"
./script/update_plist

echo "Preparing bundled resources..."
if [ "${GENERATE_SCHEMA:-false}" != "true" ]; then
  export SKIP_SETTINGS_SCHEMA=1
fi
NO_LICENSES=1 "${REPO_ROOT}/script/prepare_bundled_resources" "$NERMINAL_APP_PATH/Contents/Resources" "$NERMINAL_CHANNEL"

"${REPO_ROOT}/script/compile_icon" "$NERMINAL_CHANNEL" "$NERMINAL_APP_PATH"

if [[ ",$FEATURES," =~ ",heap_usage_tracking," ]]; then
  echo "Bundling pprof..."
  HELPERS_DIR="$NERMINAL_APP_PATH/Contents/Helpers"
  "${REPO_ROOT}/script/prepare_bundled_pprof" "$HELPERS_DIR"
fi

if [[ ",$FEATURES," =~ ",warp_control_cli," ]]; then
  WARPCTRL_SCRIPT_PATH="$NERMINAL_APP_PATH/Contents/Resources/bin/warpctrl-$NERMINAL_CHANNEL"
  echo "Creating warpctrl wrapper script at $WARPCTRL_SCRIPT_PATH..."
  "${REPO_ROOT}/script/macos/create_warpctrl_wrapper" \
    "$WARPCTRL_SCRIPT_PATH" \
    "../../MacOS/$NERMINAL_BIN_NAME"
fi

echo "Codesigning app..."
SIGNING_CERT="$(security find-identity -p codesigning -v | grep "Apple Development" | awk '{print $2}' | head -1)"
codesign --force --deep --options runtime --sign "${SIGNING_CERT:--}" "$NERMINAL_APP_PATH" --entitlements script/Debug-Entitlements.plist

if [ "$DONT_OPEN" = false ] ; then
    if  [ "$OPEN_WITH_LAUNCHD" = true ]; then
        echo "Launching with MacOS application launcher"
        PATH="" /usr/bin/open "$NERMINAL_APP_PATH"
        if [ "$NERMINAL_CHANNEL" = "local" ]; then
            LOG_FILE=~/Library/Logs/warp_local.log
        elif [ "$NERMINAL_CHANNEL" = "oss" ]; then
            LOG_FILE=~/Library/Logs/nerminal.log
        else
            echo "Warning: unrecognized NERMINAL_CHANNEL '$NERMINAL_CHANNEL', defaulting to OSS log path" >&2
            LOG_FILE=~/Library/Logs/nerminal.log
        fi
        tail -F "$LOG_FILE"
    else
        echo "Opening app at $NERMINAL_APP_PATH/Contents/MacOS/$NERMINAL_BIN_NAME"
        "$NERMINAL_APP_PATH/Contents/MacOS/$NERMINAL_BIN_NAME" "${NERMINAL_ARGS[@]}"
    fi
fi
