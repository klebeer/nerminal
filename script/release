#!/usr/bin/env bash
#
# Build, strip, sign and (optionally) notarize a distributable Nerminal.app.
#
# Releases are numbered `vMAJOR.MINOR.PATCH` and named. Names run
# alphabetically through 80s metal, horror and arcade vocabulary, avoiding
# anyone's trademarks:
#
#   1.0 Aftershock   1.6 Game Over     2.2 Mosh Pit    2.8 Speedrun
#   1.1 Boss Rush    1.7 High Score    2.3 Nosferatu   2.9 Tombstone
#   1.2 Continue     1.8 Insert Coin   2.4 Overworld   3.0 Up Up Down Down
#   1.3 Dead Air     1.9 Jawbreaker    2.5 Power Up
#   1.4 Extra Life   2.0 Killswitch    2.6 Quicksave
#   1.5 Final Boss   2.1 Level Up      2.7 Respawn
#
# Usage:
#   ./script/release v1.0.0 "Nosferatu"            # build and sign
#   ./script/release v1.0.0 "Nosferatu" --notarize # also submit to Apple
#
# Notarization needs credentials stored once, under the profile `nerminal`:
#   xcrun notarytool store-credentials nerminal \
#     --apple-id <you@example.com> --team-id 8WQ2ETQYJJ --password <app-specific>

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

TAG="${1:-}"
CODENAME="${2:-}"
NOTARIZE=false
[[ "${3:-}" == "--notarize" ]] && NOTARIZE=true

if [[ -z "$TAG" || -z "$CODENAME" ]]; then
  echo "usage: ./script/release vMAJOR.MINOR.PATCH \"Codename\" [--notarize]" >&2
  exit 1
fi
if [[ ! "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "error: tag must look like v1.0.0, got '$TAG'" >&2
  exit 1
fi

SIGNING_ID="Developer ID Application"
APP="target/release/bundle/osx/Nerminal.app"
BIN="$APP/Contents/MacOS/nerminal"

CERT="$(security find-identity -v -p codesigning | grep "$SIGNING_ID" | head -1 | awk '{print $2}')"
if [[ -z "$CERT" ]]; then
  echo "error: no '$SIGNING_ID' certificate in the keychain." >&2
  echo "Create one in Xcode: Settings > Accounts > Manage Certificates > + " >&2
  exit 1
fi

export GIT_RELEASE_TAG="$TAG"
export NERMINAL_CODENAME="$CODENAME"
export NERMINAL_BIN_NAME=nerminal
export NERMINAL_CHANNEL=oss
export NERMINAL_SKIP_COMMON_SKILLS_INSTALL=1
export FEATURES=gui

echo "==> Building $TAG \"$CODENAME\""
./script/macos/run --release --dont-open

# Stripping rewrites the binary, so it has to happen before signing or the
# signature is invalidated.
echo "==> Stripping local symbols"
strip -x "$BIN"

echo "==> Signing with Developer ID"
codesign --force --deep --options runtime --timestamp \
  --sign "$CERT" --entitlements script/Entitlements.plist "$APP"
codesign --verify --deep --strict "$APP"

echo "==> Signed:"
codesign -dvvv "$APP" 2>&1 | grep -E "Authority=Developer ID|Timestamp="

if [[ "$NOTARIZE" == true ]]; then
  ZIP="target/release/Nerminal-${TAG}.zip"
  echo "==> Submitting to Apple for notarization"
  ditto -c -k --keepParent "$APP" "$ZIP"
  xcrun notarytool submit "$ZIP" --keychain-profile nerminal --wait
  xcrun stapler staple "$APP"
  xcrun stapler validate "$APP"
  echo "==> Notarized and stapled"
fi

du -sh "$APP"
