#!/usr/bin/env bash
#
# Build, strip, sign and (optionally) notarize a distributable Nerminal.app.
#
# Releases are numbered `vMAJOR.MINOR.PATCH` and named after vampires, drawn
# from folklore or from fiction old enough to be public domain, so nobody's
# trademark is involved:
#
# A codename belongs to the minor, and its patches inherit it: v1.1.1 shipped as
# Nosferatu and v1.3.1 as Carmilla.
#
#   1.0.X - 1.2.X  Nosferatu       Murnau, 1922
#   1.3.X          Carmilla        Sheridan Le Fanu, 1872
#   1.4.X          Ruthven         Polidori, 1819
#
# Still on the table: Varney (Rymer, 1845), Orlok, Strigoi, Vourdalak, Empusa,
# Dearg-due, Draugr, Upir.
#
# Usage:
#   ./script/release v1.0.0 "Nosferatu"            # build and sign
#   ./script/release v1.0.0 "Nosferatu" --notarize # also submit to Apple
#
# Notarization needs credentials stored once, under the profile `nerminal`:
#   xcrun notarytool store-credentials nerminal \
#     --apple-id <you@example.com> --team-id 8WQ2ETQYJJ --password <app-specific>

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "${REPO_ROOT}"

TAG="${1:-}"
CODENAME="${2:-}"
NOTARIZE=false
[[ "${3:-}" == "--notarize" ]] && NOTARIZE=true

if [[ -z "$TAG" || -z "$CODENAME" ]]; then
  echo "usage: ./script/release vMAJOR.MINOR.PATCH \"Codename\" [--notarize]" >&2
  exit 1
fi
if [[ ! "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "error: tag must look like v1.0.0, got '$TAG'" >&2
  exit 1
fi

SIGNING_ID="Developer ID Application"
APP="target/release/bundle/osx/Nerminal.app"
BIN="$APP/Contents/MacOS/nerminal"

CERT="$(security find-identity -v -p codesigning | grep "$SIGNING_ID" | head -1 | awk '{print $2}')"
if [[ -z "$CERT" ]]; then
  echo "error: no '$SIGNING_ID' certificate in the keychain." >&2
  echo "Create one in Xcode: Settings > Accounts > Manage Certificates > + " >&2
  exit 1
fi

export GIT_RELEASE_TAG="$TAG"
export NERMINAL_CODENAME="$CODENAME"
export NERMINAL_BIN_NAME=nerminal
export NERMINAL_CHANNEL=oss
export NERMINAL_SKIP_COMMON_SKILLS_INSTALL=1
export FEATURES=gui

echo "==> Building $TAG \"$CODENAME\""
./script/macos/run --release --dont-open

# Stripping rewrites the binary, so it has to happen before signing or the
# signature is invalidated.
echo "==> Stripping local symbols"
strip -x "$BIN"

echo "==> Signing with Developer ID"
codesign --force --deep --options runtime --timestamp \
  --sign "$CERT" --entitlements script/Entitlements.plist "$APP"
codesign --verify --deep --strict "$APP"

echo "==> Signed:"
codesign -dvvv "$APP" 2>&1 | grep -E "Authority=Developer ID|Timestamp="

if [[ "$NOTARIZE" == true ]]; then
  ZIP="target/release/Nerminal-${TAG}.zip"
  echo "==> Submitting the app to Apple for notarization"
  ditto -c -k --keepParent "$APP" "$ZIP"
  xcrun notarytool submit "$ZIP" --keychain-profile nerminal --wait
  xcrun stapler staple "$APP"
  xcrun stapler validate "$APP"
  echo "==> App notarized and stapled"

  # The disk image is what people download, so it gets its own signature and
  # its own notarization. It has to be built from the already-stapled app so
  # the copy inside it validates offline too.
  DMG="target/release/Nerminal-${TAG}.dmg"
  STAGE="target/release/dmg-stage"
  echo "==> Building the disk image"
  rm -rf "$STAGE" "$DMG"
  mkdir -p "$STAGE"
  ditto "$APP" "$STAGE/Nerminal.app"
  create-dmg \
    --volname "Nerminal" \
    --no-internet-enable \
    --background app/assets/resources/mac/nerminal_install_image.png \
    --icon-size 128 \
    --window-size 700 500 \
    --format UDZO \
    --filesystem APFS \
    --app-drop-link 550 250 \
    --icon "Nerminal.app" 150 250 \
    "$DMG" "$STAGE"
  rm -rf "$STAGE"

  echo "==> Signing the disk image"
  codesign --force --timestamp --sign "$CERT" "$DMG"

  echo "==> Submitting the disk image to Apple"
  xcrun notarytool submit "$DMG" --keychain-profile nerminal --wait
  xcrun stapler staple "$DMG"
  xcrun stapler validate "$DMG"
  echo "==> Disk image notarized and stapled: $DMG"
  spctl -a -vvv -t install "$APP" 2>&1 | head -3
fi

du -sh "$APP"
